		sourceColumn: Sales_Thousands_SAR

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Transactions
		dataType: double
		lineageTag: 90b34169-81e0-435e-97c8-969d2b70a529
		summarizeBy: sum
		sourceColumn: Transactions

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Transaction_Date
		dataType: dateTime
		formatString: dd/mmmm/yyyy
		lineageTag: 2178d0a5-4ff3-48cf-aa15-27bfcc318944
		summarizeBy: none
