		summarizeBy: sum
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: bb4e0352-348b-4c4d-8e39-670b464b6135
		summarizeBy: none
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	column Sales_Thousands_SAR
