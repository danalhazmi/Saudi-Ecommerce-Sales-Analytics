	column Date_Year_Check = YEAR('Sheet1'[Transaction_Date])
		formatString: 0
		lineageTag: ebfe2c06-2733-4590-b535-3bc024713055
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Sheet1 = m
		mode: import
