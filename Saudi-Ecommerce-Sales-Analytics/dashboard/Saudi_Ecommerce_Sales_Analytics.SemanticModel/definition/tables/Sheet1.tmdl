				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([Periodicity] = "Monthly") and ([Indicator] = "E-Commerce Transactions Using Mada Cards : Number of Transactions" or [Indicator] = "E-Commerce Transactions Using Mada Cards : Sales (In Thousand Riyals)")),
				    #"Pivoted Column" = Table.Pivot(#"Filtered Rows", List.Distinct(#"Filtered Rows"[Indicator]), "Indicator", "Value in Different Units"),
				    #"Removed Columns" = Table.RemoveColumns(#"Pivoted Column",{"Date_Object"}),
				    #"Added Custom" = Table.AddColumn(
				    #"Removed Columns",
				    "Date.1",
				    each #date(
				        Number.From([Year]),
				        List.PositionOf(
				            {"JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"},
				            Text.Upper(Text.Trim([Month]))
				        ) + 1,
				        1
				    ),
				    type date
				),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"Date.1", type date}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type1",{{"E-Commerce Transactions Using Mada Cards : Sales (In Thousand Riyals)", "Sales_Thousands_SAR"}, {"E-Commerce Transactions Using Mada Cards : Number of Transactions", "Transactions"}, {"Date.1", "Transaction_Date"}}),
				    #"Removed Columns1" = Table.RemoveColumns(#"Renamed Columns",{"Periodicity", "Quarter", "Date"}),
				    #"Added Custom1" = Table.AddColumn(#"Removed Columns1", "Sales_SAR", each [Sales_Thousands_SAR] * 1000),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Added Custom1",{{"Sales_SAR", type number}})
				in
				    #"Changed Type2"

	annotation PBI_NavigationStepName = Navigation

