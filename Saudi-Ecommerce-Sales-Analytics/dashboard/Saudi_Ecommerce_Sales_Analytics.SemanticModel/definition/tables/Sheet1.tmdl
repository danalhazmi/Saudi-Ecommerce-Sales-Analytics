table Sheet1
	lineageTag: bad8fa69-cb89-4a22-a8bf-638cfb818b5d

	measure 'Total Sales' = SUM('Sheet1'[Sales_SAR])
		formatString: "⃁"\ #,0.00;#,0.00\ -"⃁";"⃁"\ #,0.00
		lineageTag: 98fcfac2-69d3-4acc-8d57-1a61ff8899ab

		annotation PBI_FormatHint = {"currencyCulture":"ar-SA"}

	measure 'Total Transactions' = SUM('Sheet1'[Transactions])
		formatString: 0
		lineageTag: 0a688e9a-aae6-4579-8818-3c690c6b7aac

	measure 'Average Transaction Value' =
			
			DIVIDE([Total Sales], [Total Transactions], 0)
		formatString: "⃁"\ #,0.00;#,0.00\ -"⃁";"⃁"\ #,0.00
		lineageTag: e0f13dea-b225-4d0e-8f1b-9c5855579ed9

		annotation PBI_FormatHint = {"currencyCulture":"ar-SA"}

	measure 'Previous Year Sales' =
			
			VAR LastDateWithSales =
			    CALCULATE(
			        MAX('Sheet1'[Transaction_Date]),
			        REMOVEFILTERS('Calendar')
			    )
			VAR CurrentPeriodDates =
			    FILTER(
			        VALUES('Calendar'[Date]),
			        'Calendar'[Date] <= LastDateWithSales
			    )
			RETURN
			    CALCULATE(
			        [Total Sales],
			        SAMEPERIODLASTYEAR(CurrentPeriodDates)
			    )
		formatString: "⃁"\ #,0.00;#,0.00\ -"⃁";"⃁"\ #,0.00
		lineageTag: 4a28f14c-61bd-4fe3-91ba-24180f6e4bcd

		annotation PBI_FormatHint = {"currencyCulture":"ar-SA"}

	measure 'Sales YoY %' =
			
			VAR PreviousSales = [Previous Year Sales]
			RETURN
			IF(
			    NOT ISBLANK(PreviousSales) && PreviousSales <> 0,
			    DIVIDE([Total Sales] - PreviousSales, PreviousSales),
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a32ecb21-a5c3-45b9-8a96-52b4c6fed9bf

	column Year
		dataType: int64
		formatString: 0
